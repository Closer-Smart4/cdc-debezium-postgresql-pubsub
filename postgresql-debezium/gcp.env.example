# Copy to postgresql-debezium/gcp.env and set GCP_PROJECT_ID.
# gcp.env is gitignored. scripts/gcp-config.sh, scripts/gcp-setup.sh, and
# scripts/gcp-show.sh read these values. scripts/gcp-setup.sh writes
# GCP_CREDENTIALS_FILE. That is a service account key when the project
# allows one, and your user credentials when it does not.
GCP_PROJECT_ID=your-gcp-project-id
BQ_LOCATION=EU
FUNCTION_REGION=europe-west1
